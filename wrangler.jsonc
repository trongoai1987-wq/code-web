{
  // Cấu hình triển khai lên Cloudflare.
  // Website là trang tĩnh: `npm run build` tạo ra thư mục `out`, Cloudflare
  // chỉ việc phục vụ các file trong đó, không cần máy chủ chạy code.
  //
  // `name` phải TRÙNG với tên dự án trên Cloudflare (hiện là "code-web").
  "name": "code-web",
  "compatibility_date": "2026-11-04",
  "assets": {
    // Thư mục chứa website đã build xong.
    "directory": "./out",
    // Vào địa chỉ không tồn tại thì hiện trang 404 của website.
    "not_found_handling": "404-page"
  }
}
